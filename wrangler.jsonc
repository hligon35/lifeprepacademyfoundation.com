{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mlsregistration-lifeprepacademyfoundation-com",
	"main": "mlsregistration/worker/index.js",
	"routes": [
		{
			"pattern": "mlsregistration.lifeprepacademyfoundation.com/*",
			"zone_name": "lifeprepacademyfoundation.com"
		}
	],
	"compatibility_date": "2026-08-05",
	"assets": {
		"directory": "./mlsregistration",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SIGNING_TRANSACTIONS",
				"class_name": "SigningTransactionsDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-signing-transactions-do",
			"new_sqlite_classes": [
				"SigningTransactionsDO"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "SIGNED_AGREEMENTS",
			"bucket_name": "lpaf-mls-signed-agreements",
			"remote": true
		},
		{
			"bucket_name": "lpaf-mls-signed-agreements-preview",
			"binding": "lpaf_mls_signed_agreements_preview",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lpaf-db",
			// Placeholder until `wrangler d1 create lpaf-db` is run and authorized for remote use.
			// Local development/testing works without a real database_id via `--local`.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "mlsregistration/worker/migrations"
		}
	],
	"vars": {
		"PLAYER_SIGNATURE_PLACEMENT_MODE": "parent_guardian_only",
		"ALLOWED_ORIGINS": "https://mlsregistration.lifeprepacademyfoundation.com,https://lifeprepacademyfoundation.com,https://www.lifeprepacademyfoundation.com,https://preview.lifeprepacademyfoundation.com,https://lpaf-mls.hligon.workers.dev,http://127.0.0.1:3000",
		"E_CONSENT_TEXT_VERSION": "v1-2026-08-06",
		"APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbwFGPZH8uWVuroO83DbJiyEjohYKaGUfoyMmpiiBTZtkiuF2IOH8L88Jn_iFucCw_Ll9Q/exec",
		"CONTINUATION_WEB_APP_URL": "https://script.google.com/macros/s/AKfycbxyJDjIgXpfFllY6KsfRSvp797m1nMJwsAM69FpH-tP1IVoGiDOSh-SS43YSE02F0Ro/exec"
	},
	"observability": {
		"enabled": true
	}
}
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mlsregistration-lifeprepacademyfoundation-com",
	"main": "mlsregistration/worker/index.js",
	"routes": [
		{
			"pattern": "paducahgo.lifeprepacademyfoundation.com/*",
			"zone_name": "lifeprepacademyfoundation.com"
		},
		{
			"pattern": "lifeprepacademyfoundation.com/admin*",
			"zone_name": "lifeprepacademyfoundation.com"
		},
		{
			"pattern": "www.lifeprepacademyfoundation.com/admin*",
			"zone_name": "lifeprepacademyfoundation.com"
		},
		{
			"pattern": "mlsregistration.lifeprepacademyfoundation.com",
			"zone_name": "lifeprepacademyfoundation.com",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"compatibility_date": "2026-08-05",
	"assets": {
		"directory": "./mlsregistration",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/",
			"/index.html",
			"/admin",
			"/admin/*"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SIGNING_TRANSACTIONS",
				"class_name": "SigningTransactionsDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1-signing-transactions-do",
			"new_sqlite_classes": [
				"SigningTransactionsDO"
			]
		}
	],
	"r2_buckets": [
		{
			"binding": "SIGNED_AGREEMENTS",
			"bucket_name": "lpaf-mls-signed-agreements",
			"remote": true
		},
		{
			"bucket_name": "lpaf-mls-signed-agreements-preview",
			"binding": "lpaf_mls_signed_agreements_preview",
			"remote": true
		},
		{
			"binding": "SITE_STATIC",
			"bucket_name": "site-static",
			"remote": true
		},
		{
			"binding": "SITE_ADMIN",
			"bucket_name": "site-admin",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lpaf-db",
			"database_id": "6f6edb31-4b8f-4e2d-affb-331ab438315e",
			"migrations_dir": "mlsregistration/worker/migrations"
		}
	],
	"vars": {
		"PLAYER_SIGNATURE_PLACEMENT_MODE": "parent_guardian_only",
		"ALLOWED_ORIGINS": "https://paducahgo.lifeprepacademyfoundation.com,https://programs.lifeprepacademyfoundation.com,https://mlsregistration.lifeprepacademyfoundation.com,https://lifeprepacademyfoundation.com,https://www.lifeprepacademyfoundation.com,https://preview.lifeprepacademyfoundation.com,http://127.0.0.1:3000",
		"E_CONSENT_TEXT_VERSION": "v1-2026-08-06",
		"APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbwFGPZH8uWVuroO83DbJiyEjohYKaGUfoyMmpiiBTZtkiuF2IOH8L88Jn_iFucCw_Ll9Q/exec",
		"CONTINUATION_WEB_APP_URL": "https://script.google.com/macros/s/AKfycbxyJDjIgXpfFllY6KsfRSvp797m1nMJwsAM69FpH-tP1IVoGiDOSh-SS43YSE02F0Ro/exec",
		"APPS_SCRIPT_UPDATE_TOKEN": "9333549ddcfd45c3af605d3c4056ccb914bd1e29e6704aec886b42d9c9e809e1",
		"CONTINUATION_WORKER_SHARED_SECRET": "Y5CauYcTH5xmo8IiM9r-rwGpKDWNNBIltQWYNaD9cB4"
	},
	"observability": {
		"enabled": true,
		"redact_query_string": false
	}
}
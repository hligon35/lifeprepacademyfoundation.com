{
  "name": "lifeprep-academy-optimization",
  "version": "1.0.0",
  "description": "Image optimization tools for Lifeprep Academy Foundation website",
  "main": "optimize-images.js",
  "scripts": {
    "optimize": "node optimize-images.js",
    "serve": "http-server -p 3000",
    "build": "node build-assets.js && node cache-bust.js",
    "build:prod": "node build-assets.js && node cache-bust.js && node minify-html.js",
    "format:html": "node format-html.js",
    "deploy:mlsregistration": "wrangler deploy --config wrangler.jsonc",
    "deploy:mlsregistration-preview": "wrangler deploy --config wrangler.preview.jsonc",
    "preview:mlsregistration": "wrangler dev --config wrangler.jsonc",
    "deploy:site": "wrangler deploy --config wrangler.site.jsonc",
    "preview:site": "wrangler dev --config wrangler.site.jsonc",
    "preview:player-pdf": "node mlsregistration/preview/live-pdf-preview.mjs",
    "preview:player-pdf:watch": "node mlsregistration/preview/live-pdf-preview.mjs --watch",
    "preview:volunteer-pdf": "node mlsregistration/preview/live-pdf-preview.mjs --volunteer",
    "preview:volunteer-pdf:watch": "node mlsregistration/preview/live-pdf-preview.mjs --volunteer --watch",
    "preview:ppf-pdf": "node mlsregistration/preview/live-pdf-preview.mjs --ppf",
    "preview:ppf-pdf:watch": "node mlsregistration/preview/live-pdf-preview.mjs --ppf --watch"
  },
  "devDependencies": {
    "csso": "^5.0.5",
    "http-server": "^14.1.1",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.6.2",
    "sharp": "^0.32.6",
    "terser": "^5.31.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "postal-mime": "^3.0.0"
  },
  "keywords": [
    "image-optimization",
    "performance",
    "web"
  ],
  "author": "Lifeprep Academy Foundation",
  "license": "MIT"
}

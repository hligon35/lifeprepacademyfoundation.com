        "mode": "select",
        "valueInputOption": "USER_ENTERED",
        "from": "drive",
        "spreadsheetId": "/1EIG6F00-mVhT9ws0nS3pJBrp9Y2mPH87p6UyLkWtKT4",
        "sheetId": "Players",

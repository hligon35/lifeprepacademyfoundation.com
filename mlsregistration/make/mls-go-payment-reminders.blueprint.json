        "spreadsheetId": "1EIG6F00-mVhT9ws0nS3pJBrp9Y2mPH87p6UyLkWtKT4",
        "sheetId": "Players",
        "includesHeaders": true,
        "tableFirstRow": "A1:EZ1",
        "filter": [[
          { "a": "C", "o": "exist" },
          { "a": "G", "o": "exist" },
          { "a": "CA", "o": "text:notequal:ci", "b": "Yes" },
          { "a": "CA", "o": "text:notequal:ci", "b": "True" },
          { "a": "CN", "o": "text:notequal:ci", "b": "Paid" },
          { "a": "CN", "o": "text:notequal:ci", "b": "Pending Scholarship" },
          { "a": "CR", "o": "notexist" },
          { "a": "CS", "o": "notexist" },
          { "a": "CK", "o": "exist" },
          { "a": "EG", "o": "exist" },
          { "a": "CT", "o": "notexist" }
        ]],
        "orderBy": "__ROW_NUMBER__",
        "sortOrder": "asc",
        "fieldType": "string"
      },
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "expect": {

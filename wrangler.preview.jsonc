{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "mlsregistration-preview",

  "main": "mlsregistration/worker/index.preview.js",

  "workers_dev": true,

  "compatibility_date": "2026-08-05",

  "assets": {
    "directory": "./mlsregistration",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNING_TRANSACTIONS",
        "class_name": "SigningTransactionsDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1-signing-transactions-do",
      "new_sqlite_classes": [
        "SigningTransactionsDO"
      ]
    }
  ],

  "r2_buckets": [
    {
      "binding": "SIGNED_AGREEMENTS",
      "bucket_name": "lpaf-mls-signed-agreements-preview",
      "remote": true
    },
    {
      "binding": "SITE_STATIC",
      "bucket_name": "site-static-preview",
      "remote": true
    },
    {
      "binding": "SITE_ADMIN",
      "bucket_name": "site-admin-preview",
      "remote": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lpaf-db-preview",
      "database_id": "ccfc119f-b02c-4ae8-9cfd-ad3d3f92c1b6",
      "migrations_dir": "mlsregistration/worker/migrations"
    }
  ],

  "vars": {
    "PLAYER_SIGNATURE_PLACEMENT_MODE": "parent_guardian_only",

    "ALLOWED_ORIGINS": "https://mlsregistration-preview.bhall-554.workers.dev,http://127.0.0.1:3000,http://localhost:3000",

    "E_CONSENT_TEXT_VERSION": "v1-2026-08-06",

    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbwFGPZH8uWVuroO83DbJiyEjohYKaGUfoyMmpiiBTZtkiuF2IOH8L88Jn_iFucCw_Ll9Q/exec",

    "CONTINUATION_WEB_APP_URL": "https://script.google.com/macros/s/AKfycbxyJDjIgXpfFllY6KsfRSvp797m1nMJwsAM69FpH-tP1IVoGiDOSh-SS43YSE02F0Ro/exec"
  },

  "observability": {
    "enabled": true
  }
}

# Non-secret configuration reference for local tooling and Cloudflare Worker.
# Production values belong in wrangler.jsonc vars/bindings or Wrangler secrets.
APP_ENV=development
APP_NAME=LifePrep Academy Foundation
ADMIN_BOOTSTRAP_EMAIL=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
DEFAULT_PROGRAM_ID=paducah-go-soccer-league
DEFAULT_PROGRAM_NAME=Paducah GO Soccer League
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REGISTRATION_STATUS=open
REGISTRATION_CLOSED_MESSAGE=Registration is currently closed. Please check back for future registration opportunities.
ALLOW_EXISTING_DRAFT_RESUME=true
ALLOW_PRIVATE_REGISTRATION=false
PLAYER_SIGNATURE_PLACEMENT_MODE=parent_guardian_only
E_CONSENT_TEXT_VERSION=v1-2026-08-06
APPS_SCRIPT_URL=
CONTINUATION_WEB_APP_URL=
D1_DATABASE_BINDING=lpaf-db
R2_STATIC_BUCKET=site-static
R2_ADMIN_BUCKET=site-admin
NFL_FLAG_PROGRAM_ENABLED=false
NFL_FLAG_CLINIC_PROGRAM_ENABLED=false
NFL_FLAG_PROGRAM_ID=paducah-nfl-flag-football
NFL_FLAG_CLINIC_PROGRAM_ID=paducah-nfl-flag-football-clinic
ROSTER_DEFAULT_FORMAT=5v5
ROSTER_DEFAULT_STATUS=draft
ROSTER_AUTO_REGENERATE=true
ROSTER_PRESERVE_MANUAL_OVERRIDES=true
DRAFT_EXPIRATION_DAYS=30
RESUME_TOKEN_TTL_HOURS=168
LOCAL_DRAFT_STORAGE_VERSION=v1
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_AGGREGATION_TIMEZONE=America/New_York
NEWSLETTER_ENABLED=true
NEWSLETTER_MAX_IMAGE_BYTES=5242880
NEWSLETTER_MAX_IMAGE_WIDTH=1200
NEWSLETTER_PUBLIC_ASSET_BASE_URL=
NEWSLETTER_SENDER_NAME=LifePrep Academy Foundation
NEWSLETTER_SENDER_EMAIL=
GOOGLE_MAPS_API_KEY=
TURNSTILE_SECRET=

# Worker email delivery. The API key belongs in .dev.vars/Wrangler secrets.
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=LifePrep Academy Foundation
